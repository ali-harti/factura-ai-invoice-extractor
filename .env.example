# Project settings
PROJECT_NAME="B-Agile Invoice OCR"

# AI Provider Settings
# Choose a model from OpenRouter (e.g., google/gemini-pro-1.5, qwen/qwen-2-vl-72b-instruct)
AI_MODEL_NAME="google/gemini-1.5-pro"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Database Settings
# Note: Use async driver e.g., postgresql+asyncpg for production, or sqlite+aiosqlite for local testing
DATABASE_URL="sqlite+aiosqlite:///./invoices.db"

# Redis / Celery Settings
REDIS_URL="redis://localhost:6379/0"
